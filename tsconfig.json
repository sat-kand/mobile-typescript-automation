{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "allowJs": true,
    "strict": true,
    "types": ["node", "mocha", "chai", "@wdio/globals/types"],
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@pages/*": ["src/pageobjects/*"],
      "@specs/*": ["src/test/*"]
    }
  },
  "include": ["./src", "./wdio.conf.ts"],
  "exclude": ["node_modules", "dist"]
}